# ---- Roteiro (texto) ----
# Se usar a API da Anthropic para gerar os roteiros automaticamente:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Narração ----
TTS_PROVIDER=elevenlabs         # free (edge-tts, sem custo) | elevenlabs (pago, voz mais grave/expressiva)
EDGE_TTS_VOICE=pt-BR-AntonioNeural   # ou pt-BR-FranciscaNeural (voz feminina) — só usado se TTS_PROVIDER=free
ELEVENLABS_API_KEY=
# ID da voz no painel da ElevenLabs (elevenlabs.io/app/voice-library). Como o
# model_id usado é eleven_multilingual_v2, qualquer voz fala português — pra
# tom grave, procure vozes pré-prontas como "Adam" ou "Arnold" na biblioteca.
ELEVENLABS_VOICE_ID=

# ---- Geração de imagens (escolha um provedor) ----
IMAGE_PROVIDER=ideogram          # free (Pollinations.ai, sem custo) | ideogram (pago) | openai (pago)
IDEOGRAM_API_KEY=
OPENAI_API_KEY=

# ---- Animação das cenas (opcional, etapa 3b) ----
# Se preenchida, cada cena vira um clipe animado por IA (Runway image_to_video)
# em vez de imagem estática com zoom. BEM mais caro (~$0,05/s de vídeo gerado
# no gen4_turbo) e mais lento (minutos por cena). Deixe em branco pra pular
# essa etapa e continuar usando imagem + zoom/pan.
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=720:1280

# ---- Montagem do vídeo (legendas) ----
# Caminho de uma fonte .ttf pro drawtext do ffmpeg. Só precisa preencher se
# o padrão automático (Windows/Mac/Linux) não achar uma fonte no seu sistema.
CAPTION_FONT_FILE=

# ---- Música de fundo (opcional) ----
# Caminho de uma trilha royalty-free (ex: baixada do YouTube Audio Library ou
# Pixabay Music) pra tocar baixinho por baixo da narração. Deixe em branco
# pra não usar música. Ela toca em loop e é cortada no tamanho do vídeo.
BACKGROUND_MUSIC_FILE=assets/musica/trilha.mp3
BACKGROUND_MUSIC_VOLUME=0.12

# ---- YouTube ----
YOUTUBE_CLIENT_SECRET_PATH=config/client_secret.json
YOUTUBE_TOKEN_PATH=config/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private   # private (recomendado, revise antes) | public | unlisted
