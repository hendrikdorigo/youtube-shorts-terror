# ---- Roteiro (texto) ----
# Se usar a API da Anthropic para gerar os roteiros automaticamente:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Narração ----
TTS_PROVIDER=free               # free (edge-tts, sem custo) | elevenlabs (pago)
EDGE_TTS_VOICE=pt-BR-AntonioNeural   # ou pt-BR-FranciscaNeural (voz feminina)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # ID da voz escolhida no painel da ElevenLabs

# ---- Geração de imagens (escolha um provedor) ----
IMAGE_PROVIDER=free             # free (Pollinations.ai, sem custo) | ideogram | openai
IDEOGRAM_API_KEY=
OPENAI_API_KEY=

# ---- YouTube ----
YOUTUBE_CLIENT_SECRET_PATH=config/client_secret.json
YOUTUBE_TOKEN_PATH=config/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private   # private (recomendado, revise antes) | public | unlisted
